# Publish one successfully linked module without removing the other game.
# cmake -DTARGET_H=... -DOUT=.../build.json -DLOCK=... -DWASM=.../ra2md.wasm -P build_json.cmake
file(READ "${TARGET_H}" _target)
foreach(_field EXE_NAME INI_NAME TITLE)
  string(REGEX MATCH "define RA2_${_field} \"([^\"]+)\"" _m "${_target}")
  set(_${_field} "${CMAKE_MATCH_1}")
endforeach()
string(REGEX MATCH "define RA2_EXE_STAMP (0x[0-9A-Fa-f]+)u" _m "${_target}")
math(EXPR _stamp "${CMAKE_MATCH_1}" OUTPUT_FORMAT DECIMAL)
if(_target MATCHES "RA2_TARGET_GAMEMD")
  set(_id ra2md)
  set(_script "/game/ra2md.js")
else()
  set(_id ra2)
  set(_script "/game/ra2.js")
endif()
if(NOT WASM OR NOT EXISTS "${WASM}")
  message(FATAL_ERROR "Publish build.json only after linking the module")
endif()
if(NOT RUNTIME_EXE_SOURCE OR NOT EXISTS "${RUNTIME_EXE_SOURCE}" OR
   NOT RUNTIME_EXE_NAME OR NOT RUNTIME_BLOWFISH_SOURCE OR NOT EXISTS "${RUNTIME_BLOWFISH_SOURCE}" OR
   NOT RUNTIME_DIR)
  message(FATAL_ERROR "Runtime bundle inputs are missing; configure with a local game install containing the target executable and Blowfish.dll")
endif()
file(MAKE_DIRECTORY "${RUNTIME_DIR}")
configure_file("${RUNTIME_EXE_SOURCE}" "${RUNTIME_DIR}/${RUNTIME_EXE_NAME}" COPYONLY)
configure_file("${RUNTIME_BLOWFISH_SOURCE}" "${RUNTIME_DIR}/Blowfish.dll" COPYONLY)
function(read_le32 hex_value out_var)
  string(SUBSTRING "${hex_value}" 0 2 _b0)
  string(SUBSTRING "${hex_value}" 2 2 _b1)
  string(SUBSTRING "${hex_value}" 4 2 _b2)
  string(SUBSTRING "${hex_value}" 6 2 _b3)
  math(EXPR _value "0x${_b3}${_b2}${_b1}${_b0}")
  set(${out_var} "${_value}" PARENT_SCOPE)
endfunction()
file(READ "${RUNTIME_DIR}/${RUNTIME_EXE_NAME}" _mz HEX OFFSET 0 LIMIT 2)
if(NOT _mz STREQUAL "4d5a")
  message(FATAL_ERROR "${RUNTIME_EXE_NAME} is not a PE executable")
endif()
file(READ "${RUNTIME_DIR}/${RUNTIME_EXE_NAME}" _pe_offset_hex HEX OFFSET 60 LIMIT 4)
read_le32("${_pe_offset_hex}" _pe_offset)
if(_pe_offset LESS 64 OR _pe_offset GREATER 4084)
  message(FATAL_ERROR "${RUNTIME_EXE_NAME} has an invalid PE header offset")
endif()
file(READ "${RUNTIME_DIR}/${RUNTIME_EXE_NAME}" _pe_signature HEX OFFSET ${_pe_offset} LIMIT 4)
if(NOT _pe_signature STREQUAL "50450000")
  message(FATAL_ERROR "${RUNTIME_EXE_NAME} has no PE signature")
endif()
math(EXPR _stamp_offset "${_pe_offset} + 8")
file(READ "${RUNTIME_DIR}/${RUNTIME_EXE_NAME}" _stamp_hex HEX OFFSET ${_stamp_offset} LIMIT 4)
read_le32("${_stamp_hex}" _actual_stamp)
if(NOT _actual_stamp EQUAL _stamp)
  message(FATAL_ERROR "${RUNTIME_EXE_NAME} timestamp 0x${_stamp_hex} does not match the lift (0x${_stamp})")
endif()
file(SHA256 "${RUNTIME_DIR}/${RUNTIME_EXE_NAME}" _exe_sha)
file(SHA256 "${RUNTIME_DIR}/Blowfish.dll" _blowfish_sha)
get_filename_component(_module_dir "${WASM}" DIRECTORY)
# The module stem is the edition's name (ra2md for Yuri's Revenge, ra2 for Red
# Alert 2), so the build directory's sidecars follow it too.
get_filename_component(_module_stem "${WASM}" NAME_WE)
set(_hashes "")
foreach(_ext js wasm data)
  file(SHA256 "${_module_dir}/${_module_stem}.${_ext}" _sha)
  string(APPEND _hashes "${_sha}")
endforeach()
string(SHA256 _sha "${_hashes}${_exe_sha}${_blowfish_sha}")
string(SUBSTRING "${_sha}" 0 16 _short)
file(WRITE "${RUNTIME_DIR}/runtime.json" "{\"edition\":\"${_id}\",\"build\":\"${_short}\",\"exe\":\"${_EXE_NAME}\",\"stamp\":${_stamp},\"exeSha256\":\"${_exe_sha}\",\"blowfishSha256\":\"${_blowfish_sha}\"}\n")
set(_info "{\"title\":\"${_TITLE}\",\"exe\":\"${_EXE_NAME}\",\"ini\":\"${_INI_NAME}\",\"stamp\":${_stamp},\"script\":\"${_script}\",\"build\":\"${_short}\",\"runtime\":{\"edition\":\"${_id}\",\"build\":\"${_short}\",\"exeSha256\":\"${_exe_sha}\",\"blowfishSha256\":\"${_blowfish_sha}\"}}")
# Lock outside the served directory so two target builds can publish safely.
if(NOT LOCK)
  message(FATAL_ERROR "Pass LOCK outside the served directory")
endif()
file(LOCK "${LOCK}" GUARD PROCESS TIMEOUT 60)
set(_games "{}")
if(EXISTS "${OUT}")
  file(READ "${OUT}" _previous)
  string(JSON _games GET "${_previous}" games)
endif()
string(JSON _games SET "${_games}" "${_id}" "${_info}")
# The worker's cache changes if either game changes, in either build order.
string(SHA256 _sha "${_games}")
string(SUBSTRING "${_sha}" 0 16 _build)
file(WRITE "${OUT}" "{\"games\":${_games},\"build\":\"${_build}\"}\n")
