{
  "name": "ra2-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The page for the browser build: gets the player's files in, starts the game, shows what the browser needs (docs/web/frontend.md)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json && vite build",
    "build:prod": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json && vite build --mode production",
    "build:mode": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json && vite build --mode",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --no-warn-ignored"
    ],
    "*.{json,css,md,html,yml,yaml}": "prettier --write"
  },
  "packageManager": "pnpm@9.14.2",
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22",
    "@types/react": "^18.3",
    "@types/react-dom": "^18.3",
    "@vitejs/plugin-react": "^5",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^16.4.0",
    "playwright-core": "1.49.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9",
    "typescript-eslint": "^8",
    "vite": "^7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1"
  }
}
