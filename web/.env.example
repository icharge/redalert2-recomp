# Copy to .env.production (plain `pnpm build`) or .env.prod (then build with
# `pnpm build -- --mode prod`). Shell variables override these values.
# Vite also reads .env, .env.local, .env.<mode> and .env.<mode>.local (later
# files win); .env*.local is ignored by git. Public configuration only.

# Where the built page is served from: "/" at a domain root, or a subpath such
# as "/emu/". Drives Vite's base, the router basename, asset and game-module
# URLs, service-worker scope and the manifest start_url.
RA2_BASE=/

# The WOL server the native Internet / Custom Match bridge talks to
# (docs/web/deploy.md, "WOL server endpoints"). Both are public endpoints.
# Defaults when unset: http://127.0.0.1:19090 and a WS URL derived from it.
VITE_WOL_HTTP_URL=http://127.0.0.1:19090
VITE_WOL_SOCKET_URL=wss://service.example/wol

# Other build-time values: none. The game modules, runtime bundles and
# build.json under web/public/game come from build-web.cmd/sh, not from here.
