# Copy to .env.production (plain `pnpm build`) or .env.prod (then build with
# `pnpm build -- --mode prod`). Shell variables override these values.
# Vite also reads .env, .env.local, .env.<mode> and .env.<mode>.local (later
# files win); .env*.local is ignored by git. Public configuration only.

# Where the built page is served from: "/" at a domain root, or a subpath such
# as "/emu/". Drives Vite's base, the router basename, asset and game-module
# URLs, service-worker scope and the manifest start_url.
RA2_BASE=/

# The WOL server the launcher's member routes and the native Internet / Custom
# Match bridge talk to (docs/web/deploy.md, "WOL server endpoints"). Both are
# public endpoints. Unset on the dev server (`pnpm dev`), the HTTP URL is the
# page's own origin under /ra2web/, which Vite forwards (HTTP and WebSockets) to
# RA2_WOL_PROXY_TARGET: the member's refresh cookie is then first-party on any
# host the page is opened on (localhost or 127.0.0.1). The WS URL is derived
# from the HTTP URL when unset. A build refuses http:// and ws:// to another
# machine (only loopback may stay plain http, for a local preview).
VITE_WOL_HTTP_URL=https://service.example/
VITE_WOL_SOCKET_URL=wss://service.example/wol

# Dev server only: where /ra2web/ is forwarded. Default http://127.0.0.1:9090
# (`pnpm wol-server`).
# RA2_WOL_PROXY_TARGET=http://127.0.0.1:9090

# Where the game's dead Westwood links (privacy, account, support, tournament,
# news, community, status) are shown instead. Empty: the link dialog says the
# page is offline and offers no outbound link. A page set here must allow
# framing (no X-Frame-Options/frame-ancestors block) and send
# Cross-Origin-Resource-Policy for the page's COEP: require-corp; otherwise the
# dialog's "Open in browser" is the way to it.
VITE_RA2WEB_SITE_URL=

# Local e2e builds only: 1 exposes window.ra2Store under ?e2e / ?test=1 for
# the e2e scripts (src/debug-global.ts). Never set it for a published build.
# VITE_E2E_HOOKS=1

# Other build-time values: none. The game modules, runtime bundles and
# build.json under web/public/game come from build-web.cmd/sh, not from here.
