# Build-time settings for `pnpm build` (Vite mode "production").
# Public endpoint configuration only: never put secrets in this file.
# Read by vite.config.ts (RA2_BASE) and inlined into the bundle (VITE_*).
# See docs/web/deploy.md, "Build-time settings from .env files".
#
# World Domination needs no separate production URL: the WDT state is fetched
# from the same origin as VITE_WOL_HTTP_URL (`/wdt/state?cycle=current|previous`).
# The native WDT listener (WDT_HOST/WDT_PORT) and the native WOL TCP gateway
# (WOL_TCP_HOST/WOL_TCP_PORT) are server runtime settings, not page build
# settings; do not add them here.

# Served at https://example.com/emu/: router basename, assets, game modules,
# service-worker scope and manifest all use this prefix.
RA2_BASE=/emu/

# The WOL bridge's HTTP base (register/login/WDT state) and its WebSocket
# endpoint. Both are public endpoint configuration, not secrets.
VITE_WOL_HTTP_URL=https://service.thaira2.com/
VITE_WOL_SOCKET_URL=wss://service.thaira2.com/wol

# Where the game's dead Westwood links (privacy, account, support, tournament,
# news, community, status) point. Empty: the link dialog says the page is
# offline and offers no outbound link. Point it at the public RA2Web site.
VITE_RA2WEB_SITE_URL=
